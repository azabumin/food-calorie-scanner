{
  "expo": {
    "name": "음식 칼로리 스캐너",
    "slug": "food-calorie-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "caloriescanner",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/food-calorie-scanner"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "음식 사진을 촬영해서 칼로리를 분석하기 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "음식 사진을 분석하려면 사진 접근 권한이 필요합니다.",
          "cameraPermission": "음식 사진을 촬영해서 칼로리를 분석하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ]
  }
}
